# Copia este archivo a .env y rellena las claves.

# Obligatoria. AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo a usar. Ejecuta `npm run models` para ver cuales tiene disponibles TU clave
# y pega aqui uno de la lista. No lo dejamos fijo para no inventar nombres de modelo.
GEMINI_MODEL=

# Opcional. Solo hace falta para transcribir audio. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Tarifas para estimar coste (USD por millon de tokens).
# VERIFICALAS para el modelo que elijas: https://ai.google.dev/gemini-api/docs/pricing
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=2.50

# Apify: obtiene el video de Instagram/TikTok/Facebook, que es donde estan los pasos.
# Plan gratuito: 5 USD de credito al mes, se renueva solo, no pide tarjeta.
# Token en console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=

# Tope de seguridad: maximo de llamadas a Apify por ejecucion.
APIFY_MAX=999
