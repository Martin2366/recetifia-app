# Copia este archivo a .env y rellenalo. .env NUNCA se sube al repositorio.
#
# Supabase -> tu proyecto -> Project Settings -> Data API
# La clave anon es publica por diseno: lo que protege los datos es RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud Console -> Credenciales -> ID de cliente OAuth de tipo "Aplicacion web".
# Es el MISMO valor que pegas en Supabase -> Authentication -> Providers -> Google.
# Aunque la app sea Android, aqui va el ID de cliente WEB: es el que firma el
# id_token que Supabase valida.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
